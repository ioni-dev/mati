{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/post-read-compliance.sh",
            "type": "command"
          }
        ],
        "matcher": "Read|Glob|Grep"
      },
      {
        "hooks": [
          {
            "command": ".claude/hooks/post-edit.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": ".claude/hooks/post-bash.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/pre-compact.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/pre-read.sh",
            "timeout": 3000,
            "type": "command"
          }
        ],
        "matcher": "Read|Glob|Grep"
      },
      {
        "hooks": [
          {
            "command": ".claude/hooks/pre-bash.sh",
            "timeout": 3000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/session-end.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "mati": {
      "args": [
        "serve"
      ],
      "command": "mati"
    }
  }
}
